    "knowledge_graph",
    "wisdom_engine_outputs",
    "reasoning_context",
    "reasoning_rules",
    "critique_findings"
  ],
  "decision_dimensions": [
    "evidence_support",
    "mechanistic_relevance",
    "therapeutic_efficacy",
    "safety",
    "biomarker_relevance",
    "clinical_trial_relevance",
    "development_considerations",
    "uncertainty",
    "knowledge_gaps",
    "contradictions",
    "evidence_traceability"
  ],
  "required_outputs": [
    "decision_context",
    "decision_options",
    "decision_criteria",
    "evidence_trace",
    "uncertainty_register",
    "knowledge_gap_register",
    "contradiction_register",
    "human_review_requirements",
    "decision_limitations"
  ]
