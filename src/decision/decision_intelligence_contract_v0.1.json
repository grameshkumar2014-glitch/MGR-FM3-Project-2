{
  "project": "MGR-FM3-PROJECT-2",
  "component": "Decision Intelligence",
  "version": "0.1",
  "purpose": "Create a structured decision-support layer from validated evidence, wisdom engines, reasoning, and critique outputs.",
  "decision_type": "decision_support",
  "autonomous_decision": false,
  "scientific_conclusion_generation": false,
  "human_authority": true,
  "required_inputs": [
